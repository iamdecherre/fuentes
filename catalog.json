                  "decoder": {
                    "kind": "builtin",
                    "name": "comparticomics-catalog"
                  },
                  "allowEmpty": true,
                  "fields": {
                    "title": {
                      "path": "title",
                      "required": true
                    },
                    "url": {
                      "path": "url",
                      "required": true,
                      "transforms": [
                        "absolute-url"
                      ]
                    },
                    "coverUrl": {
