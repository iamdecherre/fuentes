{
  "format": "yomiri.repository.v1",
  "name": "iamdecherre",
  "addons": [
    "https://fuentes-adapters.dokkandle.workers.dev/animeyt/manifest.json",
    "https://fuentes-adapters.dokkandle.workers.dev/katanime/manifest.json",
    "https://fuentes-adapters.dokkandle.workers.dev/monoschinos/manifest.json"
  ],
  "sources": [
    {
      "schemaVersion": 1,
      "id": "comparticomics",
      "name": "CompartiComics",
      "baseUrl": "https://comparticomics.lat",
      "allowedHosts": [
        "comparticomics.lat"
      ],
      "template": "CustomCSS",
      "requiresSession": true,
      "cacheTtlMs": 300000,
      "ui": {
        "iconUrl": "https://comparticomics.lat/favicon.ico",
        "mangaPath": "/comic/",
        "chapterPath": "/api/download/",
        "idMode": "path",
        "languages": [
          "es"
        ],
        "pageSize": 40,
        "latestOrder": "added",
        "chapterDelivery": "external-file"
      },
      "operations": {
        "search": {
          "steps": [
            {
              "url": "{baseUrl}/api/groups?page={page}&sort=relevance&unpin=1&q={query}",
              "extract": {
                "kind": "json",
                "decoder": {
                  "kind": "builtin",
                  "name": "comparticomics-catalog"
                },
                "allowEmpty": true,
                "fields": {
                  "title": {
                    "path": "title",
                    "required": true
                  },
                  "url": {
                    "path": "url",
                    "required": true,
                    "transforms": [
                      "absolute-url"
                    ]
                  },
                  "coverUrl": {
                    "path": "coverUrl",
                    "required": false,
                    "asset": true,
                    "transforms": [
                      "absolute-url"
                    ]
                  },
                  "author": {
                    "path": "author",
                    "required": false
                  },
                  "description": {
                    "path": "description",
                    "required": false
                  },
                  "genres": {
                    "path": "genres",
                    "required": false
                  }
                }
              }
            }
          ]
        },
        "detail": {
          "steps": [
            {
              "url": "{baseUrl}/api/group/{manga.id}",
              "extract": {
                "kind": "json",
                "decoder": {
                  "kind": "builtin",
                  "name": "comparticomics-detail"
                },
                "allowEmpty": true,
                "fields": {
                  "title": {
                    "path": "title",
                    "required": true
                  },
                  "url": {
                    "path": "url",
                    "required": true,
                    "transforms": [
                      "absolute-url"
                    ]
                  },
                  "coverUrl": {
                    "path": "coverUrl",
                    "required": false,
                    "asset": true,
                    "transforms": [
                      "absolute-url"
                    ]
                  },
                  "author": {
                    "path": "author",
                    "required": false
                  },
                  "description": {
                    "path": "description",
                    "required": false
                  },
                  "genres": {
                    "path": "genres",
                    "required": false
                  }
                }
              }
            }
          ]
        },
        "chapters": {
          "steps": [
            {
              "url": "{baseUrl}/api/group/{manga.id}",
              "extract": {
                "kind": "json",
                "decoder": {
                  "kind": "builtin",
                  "name": "comparticomics-chapters"
                },
                "allowEmpty": true,
                "fields": {
                  "name": {
                    "path": "name"
                  },
                  "url": {
                    "path": "url",
                    "transforms": [
                      "absolute-url"
                    ]
                  },
                  "uploadDate": {
                    "path": "uploadDate",
                    "required": false
                  }
                }
              }
            }
          ]
        },
        "pages": {
          "steps": [
            {
              "url": "{baseUrl}/api/download_check/{chapter.id}",
              "extract": {
                "kind": "json",
                "fields": {
                  "allowed": {
                    "path": "allowed"
                  }
                }
              }
            }
          ]
        }
      },
      "catalog": {
        "steps": [
          {
            "url": "{baseUrl}/api/groups?page={page}&sort=downloads&unpin=1",
            "extract": {
              "kind": "json",
              "decoder": {
                "kind": "builtin",
                "name": "comparticomics-catalog"
              },
              "allowEmpty": true,
              "fields": {
                "title": {
                  "path": "title",
                  "required": true
                },
                "url": {
                  "path": "url",
                  "required": true,
                  "transforms": [
                    "absolute-url"
                  ]
                },
                "coverUrl": {
                  "path": "coverUrl",
                  "required": false,
                  "asset": true,
                  "transforms": [
                    "absolute-url"
                  ]
                },
                "author": {
                  "path": "author",
                  "required": false
                },
                "description": {
                  "path": "description",
                  "required": false
                },
                "genres": {
                  "path": "genres",
                  "required": false
                }
              }
            }
          }
        ]
      },
      "latest": {
        "steps": [
          {
            "url": "{baseUrl}/api/groups?page={page}&sort=newest&unpin=1",
            "extract": {
              "kind": "json",
              "decoder": {
                "kind": "builtin",
                "name": "comparticomics-catalog"
              },
              "allowEmpty": true,
              "fields": {
                "title": {
                  "path": "title",
                  "required": true
                },
                "url": {
                  "path": "url",
                  "required": true,
                  "transforms": [
                    "absolute-url"
                  ]
                },
                "coverUrl": {
                  "path": "coverUrl",
                  "required": false,
                  "asset": true,
                  "transforms": [
                    "absolute-url"
                  ]
                },
                "author": {
                  "path": "author",
                  "required": false
                },
                "description": {
                  "path": "description",
                  "required": false
                },
                "genres": {
                  "path": "genres",
                  "required": false
                }
              }
            }
          }
        ]
      }
    }
  ]
}

